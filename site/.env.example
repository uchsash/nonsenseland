# ---- Required ----
DATABASE_URL=postgres://nonsense:nonsense@localhost:15433/nonsenseland
PAYLOAD_SECRET=change-me-to-a-long-random-string
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# ---- File storage: Cloudflare R2 (production). Leave empty to store files on local disk. ----
R2_BUCKET=
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# ---- Email (Resend). Needed for Send to Kindle and contact-form emails. ----
RESEND_API_KEY=
EMAIL_FROM="ননসেন্সল্যান্ড <hello@yourdomain.com>"
# The address readers add to their Amazon approved list:
KINDLE_FROM="ননসেন্সল্যান্ড <kindle@yourdomain.com>"
# Where contact-form messages are forwarded (they are always saved in the admin too):
CONTACT_TO=

# ---- Google sign-in. The button appears once both are set. ----
# Redirect URI to register at Google: <NEXT_PUBLIC_SERVER_URL>/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Spam protection: Cloudflare Turnstile. Leave empty in development. ----
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ---- Local test admin created by `npm run seed` (development only) ----
DEV_ADMIN_EMAIL=admin@nonsenseland.test
DEV_ADMIN_PASSWORD=
